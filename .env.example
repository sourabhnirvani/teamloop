# Copy to .env and fill in your own values. Never commit .env.
# TeamLoop is free only: use free-tier keys from accounts with NO billing or card attached
# (Gemini from aistudio.google.com, Groq, OpenRouter's :free models, NVIDIA build.nvidia.com, z.ai flash models,
# or local Ollama). Paid providers (Nebius) and paid OpenRouter models are skipped unless TEAMLOOP_ALLOW_PAID=1.
NEATLOGS_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
ZAI_API_KEY=
# NEBIUS_API_KEY=   (paid after its trial credit; only used with TEAMLOOP_ALLOW_PAID=1)
OLLAMA_URL=http://localhost:11434/v1
TELEGRAM_TOKEN=
# Telegram chat ids allowed to use the bot, comma-separated; everyone else is ignored. Message the bot once to get yours.
TELEGRAM_CHAT_ID=
TEAMLOOP_PORT=8790
